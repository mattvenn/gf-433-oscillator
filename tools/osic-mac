#!/bin/bash
# Mac stand-in for tools/osic :
# the local iic-osic-tools image, the repo (or a worktree of it) mounted at its own path, gf180mcuD via .designinit.
# Usage, from the repo root: tools/osic-mac <command...>
# OSIC_PDK_ROOT=<dir> uses that PDK root instead of the image's (e.g. the TT precheck's open_pdks version:
#   ciel enable --pdk-family gf180mcu --pdk-root <dir> <open_pdks commit the TT GF precheck uses>).
# Already inside the image (no docker, e.g. the sim-0 pod): run directly.
if [ -n "${IIC_OSIC_TOOLS_VERSION:-}" ] && ! command -v docker >/dev/null; then
  exec "$(dirname "$0")/osic-inimage" "$@"
fi
REPO=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$REPO/build"
cp "$REPO/.spiceinit" "$REPO/build/.spiceinit"
cd "$REPO"
PDKARGS=(); PRE=
if [ -n "${OSIC_PDK_ROOT:-}" ]; then
  PDKARGS=(-v "$OSIC_PDK_ROOT:/pdkci:ro"); PRE='export PDK_ROOT=/pdkci PDKPATH=/pdkci/gf180mcuD; '
fi
exec docker run --rm -i -v "$REPO:$REPO" -v "${DESIGNINIT:-$REPO/tools/designinit-gf180}":/foss/designs/.designinit:ro "${PDKARGS[@]}" \
  -e PDK=gf180mcuD -w "$REPO" --entrypoint /bin/bash hpretl/iic-osic-tools:2026.05 -lc "$PRE$(printf '%q ' "$@")" 2>&1 \
  | grep -v '^\[INFO\]'
